# Copie para .env e preencha com os dados do SEU projeto Supabase.
# Os dois valores estao em: Supabase -> Project Settings -> API Keys
#
# Sao publicos por design: vao no bundle que o navegador baixa. A protecao nao vem de
# esconde-los, e sim das policies de RLS, que nao dao nada a esta chave.
#
# A chave do modelo NAO entra aqui. Ela e secret da edge function, e nunca chega ao
# navegador.

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
